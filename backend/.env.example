# backend/.env.example
# Copy this file to .env and fill in your values.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=fieldpulse_ai

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-super-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── HuggingFace Inference API (Mistral NLP) ───────────────────────────────────
HF_INFERENCE_API_KEY=hf_your_key_here
HF_MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ── OTP Provider: "mock" | "msg91" | "twilio" ─────────────────────────────────
OTP_PROVIDER=mock

# MSG91 (only needed when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio (only needed when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
